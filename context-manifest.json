{
  "schema_version": "0.1",
  "project": "Idea",
  "purpose": "Route agents to the minimum sufficient context for the current task without changing project authority.",
  "bootstrap": {
    "required": [
      "AGENTS.md",
      "PROJECT_STATE.md"
    ],
    "include_user_request": true,
    "target_max_bytes": 12000
  },
  "budgets": {
    "task_context_target_max_bytes": 25000,
    "command_output_initial_max_bytes": 6000,
    "hard_truncation_of_required_context": false
  },
  "classes": [
    "REQUIRED",
    "CONDITIONAL",
    "DISCOVERY"
  ],
  "routes": {
    "STATE_OR_RESUME": {
      "required": ["PROJECT_STATE.md"],
      "conditional": ["PHASE_CURRENT.md", "EXECUTION_PLAN.md", "ROADMAP.md#specific-section"]
    },
    "DOC_ONLY": {
      "required": ["TARGET_FILE", "PROJECT_STATE.md"],
      "conditional": ["PHASE_CURRENT.md", "CANONICAL_SOURCE_FOR_TARGET"]
    },
    "G00_AUDIT": {
      "required": ["G00_AUDIT_PACKET.md", "PROJECT_STATE.md", "AUDIT.md"],
      "conditional": [
        "M0_PRODUCT_CONTRACT.md",
        "M0_DECISION_BASELINE.md",
        "M0_GOVERNANCE.md",
        "PROJECT_STANDARD.md",
        "VALIDATION_CONTRACT.md",
        "M0_VALIDATION_EVIDENCE.md",
        "schemas/*",
        "fixtures/*",
        "scripts/validate_contract.py",
        "ROADMAP.md#specific-section"
      ]
    },
    "SCHEMA_VALIDATION": {
      "required": ["AFFECTED_SCHEMA", "VALIDATION_CONTRACT.md", "scripts/validate_contract.py", "RELATED_FIXTURES"],
      "conditional": ["PROJECT_STANDARD.md", "M0_VALIDATION_EVIDENCE.md", "ROADMAP.md#specific-section"]
    },
    "PRODUCT_CONTRACT": {
      "required": ["M0_PRODUCT_CONTRACT.md", "M0_DECISION_BASELINE.md"],
      "conditional": ["M0_GOVERNANCE.md", "ARTIFACT_CATALOG.md", "ROADMAP.md#specific-section"]
    },
    "GOVERNANCE_OR_GATE": {
      "required": ["PROJECT_STATE.md", "PHASE_CURRENT.md", "M0_GOVERNANCE.md"],
      "conditional": ["AUDIT.md", "EXECUTION_PLAN.md", "ROADMAP.md#specific-section"]
    },
    "CONTEXT_EFFICIENCY": {
      "required": ["CONTEXT_POLICY.md", "AI_CONTEXT_INDEX.md", "context-manifest.json"],
      "conditional": ["PROJECT_STANDARD.md", "ROADMAP.md#F04.07", "ROADMAP.md#F15", "ROADMAP.md#F16", "ROADMAP.md#F17"]
    },
    "REFERENCE_RESEARCH": {
      "required": ["REFERENCE_MATRIX.md"],
      "conditional": ["SPECIFIC_EXTERNAL_REFERENCE", "AFFECTED_PRODUCT_SECTION"]
    },
    "ANDROID_FUTURE": {
      "required": [
        "PROJECT_STATE.md",
        "PHASE_CURRENT.md",
        "F01_F02_RELEVANT_ARTIFACTS",
        "DIRECTLY_AFFECTED_MODULE_OR_FILE"
      ],
      "conditional": ["RELEVANT_ARCHITECTURE_OR_ADR", "MODULE_TESTS", "WATCHDOG.md"],
      "authorization_note": "This route does not authorize Android implementation before the active phase and gate allow it."
    }
  },
  "watchdog_triggers": [
    "delete_files_or_data",
    "migration_or_persistence",
    "authentication_permissions_security",
    "credentials_or_secrets",
    "new_material_dependency",
    "architectural_change",
    "force_push_or_git_history_rewrite",
    "external_or_destructive_operation",
    "three_similar_failures"
  ],
  "audit_triggers": [
    "auditor_role",
    "gate_closure",
    "material_pass_fail_review",
    "explicit_independent_audit"
  ],
  "fallback": {
    "on_missing_context": "expand_progressively",
    "on_required_context_overflow": "CONTEXT_OVERFLOW",
    "on_conflict": "follow_existing_authority_precedence"
  }
}
