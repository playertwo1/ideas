{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea.local/schemas/project.schema.json",
  "title": "Idea Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "title", "mode", "originalIdea", "decisions", "requirements", "gates"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1"},
    "projectId": {"type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9_-]*$"},
    "title": {"type": "string", "minLength": 1},
    "mode": {"enum": ["LIGHT", "STANDARD", "DEEP"]},
    "originalIdea": {"type": "string", "minLength": 1},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "knownLimitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "authority": {"enum": ["USER", "AI", "SYSTEM", "EXTERNAL", "IMPORTED"]},
    "commitment": {"enum": ["CAPTURED", "SUGGESTED", "ACCEPTED", "LOCKED"]},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "author", "state", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^DEC-[A-Z0-9_-]+$"},
        "text": {"type": "string", "minLength": 1},
        "author": {"$ref": "#/$defs/authority"},
        "state": {"$ref": "#/$defs/commitment"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "acceptance", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^(REQ|NFR)-[A-Z0-9_-]+$"},
        "text": {"type": "string", "minLength": 1},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "decisionRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DEC-[A-Z0-9_-]+$"}}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^GATE-[A-Z0-9_-]+$"},
        "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "N_A"]},
        "rationale": {"type": "string"}
      }
    }
  }
}
