{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea.local/schemas/manifest.schema.json",
  "title": "Idea Export Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatorVersion", "templateVersion", "projectId", "projectRevision", "modeRequested", "capabilities", "packageStatus", "createdAt", "files", "gateResults", "knownLimitations"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1"},
    "generatorVersion": {"type": "string", "minLength": 1},
    "templateVersion": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9_-]*$"},
    "projectRevision": {"type": "integer", "minimum": 1},
    "modeRequested": {"enum": ["LIGHT", "STANDARD", "DEEP"]},
    "packageStatus": {"enum": ["DRAFT", "REVIEWED", "READY_FOR_HANDOFF"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gateResults": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^GATE-[A-Z0-9_-]+$"},
          "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "NOT_APPLICABLE"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "knownLimitations": {"type": "array", "items": {"type": "string"}}
  }
}
