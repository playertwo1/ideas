{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "standard", "phase", "validation", "fixtures", "gates"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "project": {"type": "string", "minLength": 1},
    "standard": {"type": "string", "const": "gold"},
    "phase": {"type": "string", "minLength": 1},
    "validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "fixtures": {"type": "object", "additionalProperties": false, "required": ["valid", "invalid"], "properties": {"valid": {"type": "string"}, "invalid": {"type": "string"}}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["G00", "G01", "G10"], "properties": {"G00": {"type": "string"}, "G01": {"type": "string"}, "G10": {"type": "string"}}}
  }
}
